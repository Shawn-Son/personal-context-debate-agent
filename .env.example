# Without a key, the app runs a scripted text preview.
OPENAI_API_KEY=
OPENAI_VOICE_MODEL=gpt-live-1
OPENAI_TEXT_MODEL=gpt-6-luna
# OPENAI_VOICE=marin

HOST=127.0.0.1
PORT=3000
DB_PATH=./data/context-debate.sqlite

# Set APP_PASSWORD before binding to a non-loopback interface.
APP_USERNAME=owner
APP_PASSWORD=
# Behind a reverse proxy, set the complete external HTTPS origin.
# APP_ORIGIN=https://debate.example.com
